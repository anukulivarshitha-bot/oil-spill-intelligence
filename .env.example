# Oil Spill Intelligence - Environment Configuration

# Backend
FLASK_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-here

# Database
DATABASE_URL=sqlite:///./oil_spill.db
# For PostgreSQL: postgresql://user:password@localhost:5432/oil_spill

# ML Model
MODEL_CHECKPOINT_PATH=./models/oil_spill_segmentation.pth
DEVICE=cuda  # or cpu

# Satellite Data
SATELLITE_DATA_DIR=./data/satellite
MAX_UPLOAD_SIZE_MB=500

# Environmental Data
COPERNICUS_USERNAME=your_username
COPERNICUS_PASSWORD=your_password
ERA5_API_KEY=your_api_key

# AIS Data
GFW_API_TOKEN=your_token
AIS_DATA_DIR=./data/ais

# Drift Model
DRIFT_SIMULATION_PARTICLES=1000
DRIFT_TIME_STEP_HOURS=1

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Demo Mode
DEMO_MODE=True
DEMO_DATA_PATH=./data/demo
